# Copier ce fichier en .env (jamais commité : il est dans .gitignore) puis :
#   docker compose up -d panel
# Tout est optionnel : sans valeur, la fonction est simplement désactivée.

# --- Alertes Discord : Paramètres du salon > Intégrations > Webhooks > Copier l'URL
ALERT_DISCORD_WEBHOOK=

# --- Alertes Telegram : créer un bot avec @BotFather (token), puis récupérer l'id du chat
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT=

# Événements qui déclenchent une alerte : login (login réussi), file (fichier capturé),
# country (premier visiteur d'un nouveau pays)
ALERT_EVENTS=login,file,country

# --- VirusTotal : clé gratuite sur virustotal.com (profil > API key).
# Seul le SHA-256 des fichiers capturés est envoyé, jamais le fichier.
VT_API_KEY=
